# ── Database ─────────────────────────────────────────────────────────────
# Either provide a full connection string or individual credentials.
DATABASE_URL=postgresql://postgres:your-password@host:5432/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your-database-password
SUPABASE_DB_PASSWORD=your-database-password

# ── JWT ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64 (or any random 64+ char string)
JWT_SECRET=your-64-character-random-secret-key-here-change-this-in-production

# ── CORS (comma-separated origins allowed to call this API) ──────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend-domain.com
PASA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend-domain.com

# ── Object storage (S3-compatible, e.g. Supabase storage) ────────────────
# Used ONLY for report-card PDF storage. Leave blank to disable.
# Endpoint example: https://<project-ref>.supabase.co/storage/v1/s3
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=your-s3-access-key
STORAGE_S3_SECRET_KEY=your-s3-secret-key
STORAGE_S3_BUCKET=report-cards
