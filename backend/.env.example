# ── Database ─────────────────────────────────────────────────────────────
# Get this from Supabase Dashboard → Settings → Database → Connection string
SUPABASE_DB_PASSWORD=your-database-password

# ── JWT ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64 (or any random 64+ char string)
JWT_SECRET=your-64-character-random-secret-key-here-change-this-in-production

# ── CORS (comma-separated origins allowed to call this API) ──────────────
PASA_CORS_ORIGINS=http://localhost:5173,https://getpasa.netlify.app
