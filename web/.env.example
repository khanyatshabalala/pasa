# Copy to .env and fill in. Vite embeds every VITE_* value into the browser bundle,
# so only put PUBLIC values here. Never add database keys, service-role keys or
# client secrets to this app: it talks only to the Spring Boot API.

# Spring Boot backend origin, no trailing slash (default http://localhost:8080)
VITE_API_URL=https://your-backend.example.com

# Web push notifications (VAPID). Only the PUBLIC key goes here.
# Generate with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
